// Configuración de Cloudflare (Workers) para amadesu.com.
// Sin este archivo, Cloudflare ya no publica el sitio (por la carpeta functions/).
{
  "name": "amadesu-tiempos",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // El programa solo corre en la portada y en /info (vista previa de enlaces);
    // todo lo demás se entrega directo.
    "run_worker_first": ["/", "/index.html", "/info", "/info.html"]
  }
}
